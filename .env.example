# Copy to .env and fill in. Without any key the app runs in offline-template mode
# (all analysis is still computed; only the narrative comes from templates).

# Which AI to use: anthropic | gemini | openrouter (default: first key found in that order)
LLM_PROVIDER=

# Anthropic (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low
# Server-side refusal fallback (beta, Anthropic only). Set to "off" to disable.
CLAUDE_FALLBACKS=on

# Google Gemini (free tier available at https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# OpenRouter (Claude via Anthropic-compatible endpoint); set ANTHROPIC_MODEL=anthropic/claude-opus-5.5
OPENROUTER_API_KEY=
